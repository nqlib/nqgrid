{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": false,
    "types": ["vite/client"],
    "paths": {
      "@/lib/utils": ["./src/beecharts/lib-utils.ts"],
      "@/registry/*": ["./src/beecharts/registry/*"],
      "@nqlib/nqgrid": ["../../src/index.ts"],
      "@nqlib/nqgrid/engine": ["../../src/engine/index.ts"],
      "@nqlib/nqgrid/grid": ["../../src/grid/index.ts"],
      "@nqlib/nqgrid/sheet": ["../../src/sheet/index.ts"],
      "@nqlib/nqgrid/spreadsheet": ["../../src/spreadsheet/index.ts"],
      "@nqlib/nqgrid/advanced": ["../../src/advanced/index.ts"],
      "@nqlib/nqgrid/configurator": ["../../src/configurator/index.ts"],
      "@nqlib/nqgrid/fixtures": ["../../src/fixtures/index.ts"],
      "@nqlib/nqgrid/core": ["../../src/core/index.ts"],
      "@nqlib/nqgrid/pivot": ["../../src/pivot/index.ts"],
      "@nqlib/nqgrid/render-static": ["../../src/render-static/index.ts"],
      "@nqlib/nqgrid/styles": ["../../src/styles/index.ts"]
    }
  },
  "include": ["src"]
}
