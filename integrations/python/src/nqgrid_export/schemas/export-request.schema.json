{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nqlib/nqgrid/contract/pivot/v1/export-request.schema.json",
  "title": "PivotExportRequest",
  "description": "nqgrid pivot export request v1: what nqgrid-export reads (CLI --input, POST /export) and what an app sends to a backend that owns the data. Mirrors src/core/pivot/export-request.ts. nqgrid-export itself needs `rows`; a backend resolves `dataset` to rows before calling it. Render options are JSON-only: raw CSS / HTML is never accepted.",
  "type": "object",
  "required": [
    "spec"
  ],
  "anyOf": [
    {
      "title": "PivotExportRequestWithRows",
      "required": [
        "rows"
      ]
    },
    {
      "title": "PivotExportRequestWithDataset",
      "required": [
        "dataset"
      ]
    }
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "$ref": "pivot-spec.schema.json"
    },
    "rows": {
      "description": "Leaf-grain data rows (one object per row; values are plain JSON).",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dataset": {
      "description": "Opaque reference to rows the backend owns (e.g. a dataset or saved query id). Ignored by nqgrid-export.",
      "type": "string",
      "minLength": 1
    },
    "format": {
      "$ref": "#/$defs/format"
    },
    "options": {
      "$ref": "#/$defs/options"
    }
  },
  "$defs": {
    "format": {
      "description": "Output format. The CLI --format flag / ?format= query parameter wins over this field.",
      "enum": [
        "pdf",
        "xlsx",
        "html",
        "model",
        "sheet"
      ]
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "options": {
      "description": "JSON-safe render options (renderPivotHtml options minus css, plus PDF-only headerFooter).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "enum": [
                "A4",
                "A3",
                "Letter",
                "Legal",
                "Tabloid"
              ]
            },
            "orientation": {
              "enum": [
                "landscape",
                "portrait"
              ]
            },
            "margins": {
              "description": "Page margins in mm.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "top": {
                  "$ref": "#/$defs/marginMm"
                },
                "right": {
                  "$ref": "#/$defs/marginMm"
                },
                "bottom": {
                  "$ref": "#/$defs/marginMm"
                },
                "left": {
                  "$ref": "#/$defs/marginMm"
                }
              }
            }
          }
        },
        "title": {
          "description": "Report title (default spec.title); null hides the report header.",
          "type": [
            "string",
            "null"
          ]
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatedAt": {
          "description": "Printed verbatim (the exporter never reads the clock).",
          "type": [
            "string",
            "null"
          ]
        },
        "maxColumnsPerPage": {
          "type": "integer",
          "minimum": 1
        },
        "minScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "kpiPanel": {
          "type": "boolean"
        },
        "headerFooter": {
          "description": "PDF running header (title) and footer (generated / page X of Y). Default true.",
          "type": "boolean"
        },
        "locale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lang": {
              "type": "string"
            },
            "generated": {
              "type": "string"
            },
            "continued": {
              "type": "string"
            },
            "columns": {
              "type": "string"
            },
            "of": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dimensionWidths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/positiveNumber"
              }
            },
            "valueWidth": {
              "$ref": "#/$defs/positiveNumber"
            },
            "rowHeight": {
              "$ref": "#/$defs/positiveNumber"
            },
            "headRowHeight": {
              "$ref": "#/$defs/positiveNumber"
            },
            "chartHeight": {
              "$ref": "#/$defs/positiveNumber"
            },
            "headerChart": {
              "type": "boolean"
            },
            "kpiHeadlineId": {
              "type": "string"
            },
            "kpiCaptionAttribute": {
              "type": "string"
            }
          }
        }
      }
    },
    "marginMm": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 100
    }
  }
}
