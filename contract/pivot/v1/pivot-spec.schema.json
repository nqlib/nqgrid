{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nqlib/nqgrid/contract/pivot/v1/pivot-spec.schema.json",
  "title": "PivotSpec",
  "description": "nqgrid pivot spec v1. Mirrors src/core/pivot/types.ts. Referential checks (measure ids used by values/heat/headerCharts/kpis/sortBy/topN, sortBy/topN only on row dimensions, unique facets) are done by validatePivotSpec().",
  "type": "object",
  "required": [
    "version",
    "rows",
    "measures"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "columns": {
      "$ref": "#/$defs/dimension"
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/measure"
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grandTotal": {
          "type": "boolean"
        },
        "grandTotalPosition": {
          "enum": [
            "top",
            "bottom"
          ]
        },
        "grandTotalLabel": {
          "type": "string"
        },
        "rowTotal": {
          "type": "boolean"
        },
        "rowTotalLabel": {
          "type": "string"
        }
      }
    },
    "expanded": {
      "oneOf": [
        {
          "enum": [
            "all",
            "none"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      ]
    },
    "heat": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "measure": {
              "type": "string"
            },
            "scope": {
              "enum": [
                "all",
                "column",
                "row",
                "group"
              ]
            },
            "levels": {
              "type": "integer",
              "minimum": 2,
              "maximum": 32
            },
            "applyTo": {
              "enum": [
                "leaf",
                "group",
                "all"
              ]
            },
            "domain": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    },
    "headerCharts": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "measure": {
              "type": "string"
            },
            "type": {
              "enum": [
                "bar",
                "line"
              ]
            },
            "breakdown": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "measure"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "measure": {
            "type": "string",
            "minLength": 1
          },
          "compareTo": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "$ref": "#/$defs/numberFormat"
          },
          "deltaFormat": {
            "$ref": "#/$defs/numberFormat"
          }
        }
      }
    },
    "kpiLevels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "layout": {
      "enum": [
        "tabular",
        "compact"
      ]
    },
    "filters": {
      "description": "Report / slicer / label filters on any record field, applied to records before aggregation (totals reflect them). Filters on different fields are ANDed.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "facets": {
      "description": "Fields returned as model.facets (distinct values with cross-filtered counts and selection) for slicers and filter menus.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/facet"
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": [
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sort": {
          "enum": [
            "asc",
            "desc",
            "none"
          ]
        },
        "keepEmpty": {
          "type": "boolean"
        },
        "blankLabel": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sortBy": {
          "$ref": "#/$defs/sortBy"
        },
        "topN": {
          "$ref": "#/$defs/topN"
        }
      }
    },
    "aggregate": {
      "oneOf": [
        {
          "title": "BuiltInAggregate",
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count",
            "first",
            "last"
          ]
        },
        {
          "title": "WeightedAvgAggregate",
          "type": "object",
          "required": [
            "type",
            "weightField"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "weightedAvg"
            },
            "weightField": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "title": "RatioAggregate",
          "type": "object",
          "required": [
            "type",
            "numeratorField",
            "denominatorField"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ratio"
            },
            "numeratorField": {
              "type": "string",
              "minLength": 1
            },
            "denominatorField": {
              "type": "string",
              "minLength": 1
            },
            "offset": {
              "type": "number"
            }
          }
        },
        {
          "title": "CustomAggregate",
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "custom"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "showAs": {
      "enum": [
        "value",
        "percentOfColumnTotal",
        "percentOfParentRow",
        "percentOfRowTotal",
        "percentOfGrandTotal"
      ]
    },
    "measure": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "aggregate": {
          "$ref": "#/$defs/aggregate"
        },
        "format": {
          "$ref": "#/$defs/numberFormat"
        },
        "percentFormat": {
          "$ref": "#/$defs/numberFormat"
        },
        "showAs": {
          "$ref": "#/$defs/showAs"
        },
        "groupShowAs": {
          "$ref": "#/$defs/showAs"
        }
      },
      "allOf": [
        {
          "$comment": "field is required unless the aggregate is count, ratio or custom",
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "aggregate"
                  ]
                }
              },
              {
                "required": [
                  "aggregate"
                ],
                "properties": {
                  "aggregate": {
                    "enum": [
                      "sum",
                      "avg",
                      "min",
                      "max",
                      "first",
                      "last"
                    ]
                  }
                }
              },
              {
                "required": [
                  "aggregate"
                ],
                "properties": {
                  "aggregate": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "weightedAvg"
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "field"
            ]
          }
        }
      ]
    },
    "numberFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "decimal",
            "currency",
            "percent"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "currencySymbol": {
          "type": "string"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "compact": {
          "type": "boolean"
        },
        "significantDigits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21
        },
        "compactUnits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "signDisplay": {
          "enum": [
            "auto",
            "always",
            "exceptZero",
            "never"
          ]
        },
        "negative": {
          "enum": [
            "minus",
            "parentheses"
          ]
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "groupSeparator": {
          "type": "string"
        },
        "decimalSeparator": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        }
      }
    },
    "sortBy": {
      "title": "SortBy",
      "description": "Row dimensions only: order sibling keys by an aggregated measure (wins over order / sort, which break ties). Keys without a value sort last.",
      "type": "object",
      "required": [
        "measure"
      ],
      "additionalProperties": false,
      "properties": {
        "measure": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "columnKey": {
          "type": "string",
          "description": "Rank by this column-dimension key (default: the row total)."
        }
      }
    },
    "topN": {
      "title": "TopN",
      "description": "Row dimensions only: keep the top / bottom `count` keys within each parent group (outermost level first). Excluded keys leave every total unless `other` folds them into one row.",
      "type": "object",
      "required": [
        "measure",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "measure": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "direction": {
          "enum": [
            "top",
            "bottom"
          ]
        },
        "columnKey": {
          "type": "string",
          "description": "Rank by this column-dimension key (default: the row total)."
        },
        "other": {
          "type": "boolean",
          "description": "Fold the remaining keys into one row (key \"\\u0000other\")."
        },
        "otherLabel": {
          "type": "string"
        }
      }
    },
    "labelMatch": {
      "title": "LabelMatch",
      "description": "Label filter on the key string (null → \"\"). Case-insensitive unless caseSensitive.",
      "type": "object",
      "required": [
        "op",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "contains",
            "notContains",
            "beginsWith",
            "endsWith",
            "equals",
            "notEquals"
          ]
        },
        "value": {
          "type": "string"
        },
        "caseSensitive": {
          "type": "boolean"
        }
      }
    },
    "filter": {
      "title": "Filter",
      "description": "Keys compare as strings (null → \"\", 2024 → \"2024\"). include: [] keeps nothing; a filter with no include / exclude / match keeps everything.",
      "type": "object",
      "required": [
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "match": {
          "$ref": "#/$defs/labelMatch"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "facet": {
      "oneOf": [
        {
          "title": "FacetField",
          "type": "string",
          "minLength": 1
        },
        {
          "title": "FacetWithLabel",
          "type": "object",
          "required": [
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            }
          }
        }
      ],
      "description": "A field name, or { field, label } to override the slicer label."
    }
  }
}
